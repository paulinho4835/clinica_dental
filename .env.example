# Supabase — copia a .env.local y rellena tras `supabase start`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor (NUNCA exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=

# ── Vapi (llamadas de voz con IA) ────────────────────────────────────────────
# Dashboard: https://dashboard.vapi.ai
VAPI_API_KEY=                        # Settings → API Keys → Private Key
NEXT_PUBLIC_VAPI_PUBLIC_KEY=         # Settings → API Keys → Public Key (para el demo web)
VAPI_PHONE_NUMBER_ID=                # Phone Numbers → ID del número comprado
VAPI_REMINDER_ASSISTANT_ID=          # Assistants → ID del asistente de recordatorios
VAPI_WEBHOOK_SECRET=                 # Phone Number → Server Secret (opcional pero recomendado)
VAPI_CLINIC_ID=                      # UUID de tu clínica en Supabase (prototipo mono-clínica)
